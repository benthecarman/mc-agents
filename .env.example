# Copy to .env to override these; direnv loads .env. No API keys needed:
# the local Maple proxy (maple-proxy.service) answers without a key on
# loopback and speaks the OpenAI chat-completions API.
#
#   let client = ApiClient::new_with_tls(
#       std::env::var("MAPLE_BASE_URL")?, AuthMethod::NoAuth, None)?;
#   let provider = OpenAiProvider::new(client); // POSTs to v1/chat/completions
#   let model = ModelConfig::new(std::env::var("MAPLE_MODEL")?);

MAPLE_BASE_URL=http://127.0.0.1:8888
# Tool calling checked on glm-5-3-flash. List the others with:
#   curl -s $MAPLE_BASE_URL/v1/models | jq -r '.data[].id'
MAPLE_MODEL=glm-5-3-flash
